# ---------------------------
# Python Specific
# ---------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.dmypy.json
dmypy.json
*.log
*.pid
*.seed
*.pid.lock
*.egg-info/
*.egg
*.dist-info
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# ---------------------------
# Virtual Environments
# ---------------------------
venv/
env/
ENV/
env.bak/
venv.bak/
.env/
.venv/
virtualenv/
pyvenv.cfg
pip-selfcheck.json

# ---------------------------
# Node.js / JavaScript
# ---------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml
.npm/
.npmrc
.yarn/
.yarnrc
.yarn-integrity

