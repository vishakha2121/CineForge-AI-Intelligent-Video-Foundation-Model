# React / Frontend Build
# ---------------------------
/build/
/dist/
/.cache/
/.parcel-cache/
.next/
out/
.nuxt/
.storybook-out/
*.tsbuildinfo
*.min.js
*.min.css
*.bundle.js
*.chunk.js

